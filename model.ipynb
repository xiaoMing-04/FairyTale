7746Z","shell.execute_reply":"2025-05-11T05:35:26.426675Z","shell.execute_reply.started":"2025-05-11T05:35:12.776776Z"}}},{"id":"90fbdceb","cell_type":"markdown","source":"Bây giờ chúng ta sẽ thực hiện huấn luyện mô hình trên bộ dữ liệu đã cân bằng xem liệu kết quả có tốt hơn không. Bộ dữ liệu gốc có tổng cộng hơn 40 triệu dòng, với tỷ lệ là `0.86` cho lớp `0`. Sau khi chúng ta thực hiện giảm bớt lớp đa số, dữ liệu sẽ còn hơn `13` triệu dòng với tỷ lệ `1:1`.","metadata":{}},{"id":"81cce0ff","cell_type":"code","source":"parse_date = lambda val: pd.to_datetime(val, format='%y%m%d%H')\n\ndf = pd.read_csv(\n    \"/kaggle/input/avazu-ctr-prediction/train.gz\",\n    parse_dates=['hour'],\n    date_format='%y%m%d%H'\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-05-17T02:23:06.595228Z","iopub.execute_input":"2025-05-17T02:23:06.595576Z","iopub.status.idle":"2025-05-17T02:23:06.604913Z","shell.execute_reply.started":"2025-05-17T02:23:06.595551Z","shell.execute_reply":"2025-05-17T02:23:06.600527Z"}},"outputs":[],"execution_count":23},{"id":"0158157c","cell_type":"code","source":"df['hour_of_day'] = df['hour'].dt.hour\ndf['day_of_week'] = df['hour'].dt.dayofweek\n\ngroup_data = df[['hour_of_day', 'device_id']].groupby('hour_of_day').count()\ndf['hourly_user_counts'] = df['hour_of_day'].map(group_data['device_id'])\n\ngroup_data = df[['day_of_week', 'device_id']].groupby('day_of_week').count()\ndf['weekly_user_counts'] = df['day_of_week'].map(group_data['device_id'])\n\ngroup_data = df[['device_id', 'id']].groupby('device_id').count()\ndf['device_id_counts'] = df['device_id'].map(group_data['id'])\n\ngroup_data = df[['device_ip', 'id']].groupby('device_ip').count()\ndf['device_ip_counts'] = df['device_ip'].map(group_data['id'])\n\ndf['user'] = df['device_id'] + ',' + df['device_model']\n\ngroup_data = df[['hour_of_day', 'id']].groupby('hour_of_day').count()\ndf['hourly_impression_counts'] = df['hour_of_day'].map(group_data['id'])\n\ndf['frequent_of_app_id'] = df['user'].map(\n    df.groupby('user')['app_id'].count() / df['app_id'].nunique()\n)\n\ndf['frequent_of_site_id'] = df['user'].map(\n    df.groupby('user')['site_id'].count() / df['site_id'].nunique()\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-05-17T02:19:26.902930Z","iopub.execute_input":"2025-05-17T02:19:26.903235Z","iopub.status.idle":"2025-05-17T02:19:26.956183Z","shell.execute_reply.started":"2025-05-17T02:19:26.903210Z","shell.execute_reply":"2025-05-17T02:19:26.951711Z"}},"outputs":[],"execution_count":20},{"id":"4e4766f6-6f08-418e-b149-13924961609d","cell_type":"code","source":"from imblearn.under_sampling import RandomUnderSampler\n\nX = df.drop('click', axis=1)\ny = df['click']\nrus = RandomUnderSampler(random_state=42)\nX_resampled, y_resampled = rus.fit_resample(X, y)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-05-17T02:19:50.542426Z","iopub.execute_input":"2025-05-17T02:19:50.542769Z","iopub.status.idle":"2025-05-17T02:19:50.568664Z","shell.execute_reply.started":"2025-05-17T02:19:50.542740Z","shell.execute_reply":"2025-05-17T02:19:50.563836Z"}},"outputs":[],"execution_count":21},{"id":"52a708ec","cell_type":"code","source":"X_train, X_test, y_train, y_test = train_test_split(X_resampled, y_resampled, test_size=0.2, stratify=y_resampled, random_state=42)\n\ntrain = pd.concat([X_train, y_train], axis=1)\ntest = pd.concat([X_test, y_test], axis=1)\n\nscaler = fit_min_max_scaler(train, count_columns)\nencoder = fit_target_encoder(train, target_columns)\nctr_maps = fit_ctr_encoding(train, ctr_columns)\n\nX_train = train.drop(['id', 'hour', 'click'], axis=1)\nX_test = test.drop(['id', 'hour', 'click'], axis=1)\ny_train = train['click']\ny_test = test['click']\n\nX_train = pd.concat([\n    transform_min_max_scaler(X_train, scaler),\n    transform_target_encoding(X_train, encoder, target_columns),\n    transform_ctr_encoding(X_train, ctr_maps)\n], axis=1)\n\nX_test = pd.concat([\n    transform_min_max_scaler(X_test, scaler),\n    transform_target_encoding(X_test, encoder, target_columns),\n    transform_ctr_encoding(X_test, ctr_maps)\n], axis=1)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-05-17T02:21:23.169908Z","iopub.execute_input":"2025-05-17T02:21:23.170229Z","iopub.status.idle":"2025-05-17T02:21:23.620013Z","shell.execute_reply.started":"2025-05-17T02:21:23.170204Z","shell.execute_reply":"2025-05-17T02:21:23.615083Z"}},"outputs":[],"execution_count":22},{"id":"b9839971-a75d-43a6-b23a-952ec94e52ef","cell_type":"markdown","source":"## 10.1. Logistic Regression","metadata":{}},{"id":"dd20a47a-50bf-4494-9ac3-3570963579a0","cell_type":"code","source":"model = LogisticRegression(\n            solver='qn',\n            penalty='l2',\n            C=2.667777777777778,\n            class_weight='balanced',\n            fit_intercept=True,\n            max_iter=15000\n)\n\nmodel.fit(X_train, y_train)\ny_pred = model.predict(X_test)\ny_pred_prob = model.predict_proba(X_test)\n\n# Accuracy\nprint(f'Accuracy: {metrics.accuracy_score(y_test, y_pred):.4f}')\n\n# Precision, Recall, F1\nprint(f'Precision: {metrics.precision_score(y_test, y_pred, average=\"binary\"):.4f}')\nprint(f'Recall: {metrics.recall_score(y_test, y_pred, average=\"binary\"):.4f}')\nprint(f'F1 Score (macro): {metrics.f1_score(y_test, y_pred, average=\"macro\"):.4f}')\nprint(f'F1 Score (weighted): {metrics.f1_score(y_test, y_pred, average=\"weighted\"):.4f}')\n\n# Log loss\nprint(f'Log Loss: {metrics.log_loss(y_test, y_pred_prob):.4f}')\n\n# Classification report\nprint(\"\\nClassification Report:\")\nprint(metrics.classification_report(y_test, y_pred, digits=4))","metadata":{"execution":{"iopub.status.busy":"2025-05-18T01:56:17.382550Z","iopub.execute_input":"2025-05-18T01:56:17.383147Z","iopub.status.idle":"2025-05-18T01:56:36.470512Z","shell.execute_reply.started":"2025-05-18T01:56:17.383127Z","shell.execute_reply":"2025-05-18T01:56:36.469798Z"},"trusted":true},"outputs":[{"name":"s