sattr(model, 'classes_'):\n            self.classes_ = model.classes_\n\n    def predict(self, X):\n        return self.model.predict(X)\n\n    def predict_proba(self, X):\n        return np.asarray(self.model.predict_proba(X))\n\n    def fit(self, X, y):\n        fitted = self.model.fit(X, y)\n        self.classes_ = self.model.classes_\n        return self","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-05-18T03:16:16.889747Z","iopub.execute_input":"2025-05-18T03:16:16.890405Z","iopub.status.idle":"2025-05-18T03:16:16.895310Z","shell.execute_reply.started":"2025-05-18T03:16:16.890380Z","shell.execute_reply":"2025-05-18T03:16:16.894584Z"}},"outputs":[],"execution_count":20},{"id":"d22530d3-169b-4ce8-aab8-01f81b38674d","cell_type":"code","source":"wrapped_model = WrappedModel(model)\ncalibrated_model = CalibratedClassifierCV(estimator=wrapped_model, cv='prefit')\ncalibrated_model.fit(X_train_fi, y_train)\n\ny_pred = calibrated_model.predict(X_test_fi)\ny_pred_prob = calibrated_model.predict_proba(X_test_fi)\n\n# Accuracy\nprint(f'Accuracy: {metrics.accuracy_score(y_test, y_pred):.4f}')\n\n# Precision, Recall, F1\nprint(f'Precision: {metrics.precision_score(y_test, y_pred, average=\"binary\"):.4f}')\nprint(f'Recall: {metrics.recall_score(y_test, y_pred, average=\"binary\"):.4f}')\nprint(f'F1 Score (macro): {metrics.f1_score(y_test, y_pred, average=\"macro\"):.4f}')\nprint(f'F1 Score (weighted): {metrics.f1_score(y_test, y_pred, average=\"weighted\"):.4f}')\n\n# Log loss\nprint(f'Log Loss: {metrics.log_loss(y_test, y_pred_prob):.4f}')\n\n# Classification report\nprint(\"\\nClassification Report:\")\nprint(metrics.classification_report(y_test, y_pred, digits=4))","metadata":{"execution":{"iopub.status.busy":"2025-05-18T03:16:18.554600Z","iopub.execute_input":"2025-05-18T03:16:18.555167Z","iopub.status.idle":"2025-05-18T03:18:07.458834Z","shell.execute_reply.started":"2025-05-18T03:16:18.555143Z","shell.execute_reply":"2025-05-18T03:18:07.458082Z"},"t