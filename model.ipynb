    "skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\n",
    "results = []\n",
    "\n",
    "for C, penalty, class_weight, fit_intercept in tqdm(param_list):\n",
    "    log_losses = []\n",
    "    for train_idx, val_idx in skf.split(X_train, y_train):\n",
    "        X_tr, X_val = X_train.iloc[train_idx], X_train.iloc[val_idx]\n",
    "        y_tr, y_val = np.ravel(y_train.iloc[train_idx]), np.ravel(y_train.iloc[val_idx])\n",
    "\n",
    "\n",
    "        if penalty != 'l2':\n",
    "            continue\n",
    "\n",
    "        model = LogisticRegression(\n",
    "            solver='qn',\n",
    "            penalty=penalty,\n",
    "            class_weight=class_weight,\n",
    "            C=C,\n",
    "            fit_intercept=fit_intercept,\n",
    "            max_iter=5000\n",
    "        )\n",
    "\n",
    "        model.fit(X_tr, y_tr)\n",
    "        y_proba = model.predict_proba(X_val).iloc[:, 1]\n",
    "        loss = metrics.log_loss(y_val, y_proba)\n",
    "        log_losses.append(loss)\n",
    "\n",
    "        del model, y_proba\n",
    "        gc.collect()\n",
    "\n",
    "    if log_losses:\n",
    "        avg_loss = np.mean(log_losses)\n",
    "        results.append(((C, penalty, class_weight, fit_intercept), avg_loss))"
   ]
