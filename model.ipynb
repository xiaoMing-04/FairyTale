, y_pred):.4f}')\n\n# Precision, Recall, F1\nprint(f'Precision: {metrics.precision_score(y_test, y_pred, average=\"binary\"):.4f}')\nprint(f'Recall: {metrics.recall_score(y_test, y_pred, average=\"binary\"):.4f}')\nprint(f'F1 Score (macro): {metrics.f1_score(y_test, y_pred, average=\"macro\"):.4f}')\nprint(f'F1 Score (weighted): {metrics.f1_score(y_test, y_pred, average=\"weighted\"):.4f}')\n\n# Log loss\nprint(f'Log Loss: {metrics.log_loss(y_test, y_pred_prob):.4f}')\n\n# Classification report\nprint(\"\\nClassification Report:\")\nprint(metrics.classification_report(y_test, y_pred, digits=4))","metadata":{"execution":{"iopub.status.busy":"2025-05-18T01:26:26.711063Z","iopub.execute_input":"2025-05-18T01:26:26.711870Z","iopub.status.idle":"2025-05-18T01:27:00.588183Z","shell.execute_reply.started":"2025-05-18T01:26:26.711840Z","shell.execute_reply":"2025-05-18T01:27:00.587386Z"},"id":"8f9f0f26-1ffd-4d67-b0c7-a073b91208db","outputId":"2d8e526f-3054-4380-aaf0-111f055c07fb","trusted":true},"outputs":[{"name":"stdout","text":"Accuracy: 0.7387\nPrecision: 0.3204\nRecall: 0.4812\nF1 Score (macro): 0.6094\nF1 Score (weighted): 0.7579\nLog Loss: 0.6344\n\nClassification Report:\n              precision    recall  f1-score   support\n\n           0     0.8818    0.7914    0.8342   2490853\n           1     0.3204    0.4812    0.3847    509147\n\n    accuracy                         0.7387   3000000\n   macro avg     0.6011    0.6363    0.6094   3000000\nweighted avg     0.7865    0.7387    0.7579   3000000\n\n","output_type":"stream"}],"execution_count":22},{"id":"31b2618b","cell_type":"code","source":"plot_recall_precision_matrices(y_test, y_pred, [1, 0], 'plasma')","metadata":{"execution":{"iopub.status.busy":"2025-05-18T01:27:20.976857Z","iopub.execute_input":"2025-05-18T01:27:20.977423Z","iopub.status.idle":"2025-05-18T01:27:25.378734Z","shell.execute_reply.started":"2025-05-18T01:27:20.977399Z","shell.execute_reply":"2025-05-18T01:27:25.377945Z"},"id":"c19d040c-4b82-4b