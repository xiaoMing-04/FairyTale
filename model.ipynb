    "        n_estimators=500,\n",
    "        min_child_weight=3,\n",
    "        max_depth=6,\n",
    "        learning_rate=0.2,\n",
    "        colsample_bytree=0.6,\n",
    "        gamma=0.3\n",
    "    )\n",
    "    model.fit(X_train_pca_tf, y_train)\n",
    "    end = time.time()\n",
    "    \n",
    "    y_pred = model.predict(X_test_pca_tf)\n",
    "    y_pred_prob = model.predict_proba(X_test_pca_tf)\n",
    "    \n",
    "    scores.append(metrics.log_loss(y_test, y_pred_prob))\n",
    "    times.append(end - start)"
   ]
