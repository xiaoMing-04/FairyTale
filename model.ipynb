,"outputs":[],"execution_count":22},{"id":"9accb720-60bd-4280-b4e5-d2bcf67e3020","cell_type":"markdown","source":"## 11.1 Logistic Regression","metadata":{}},{"id":"c7e381ff-39b4-4175-b568-5dc4cf2083ac","cell_type":"code","source":"model = LogisticRegression(\n            solver='qn',\n            penalty='l2',\n            C=2.667777777777778,\n            class_weight='balanced',\n            fit_intercept=True,\n            max_iter=30000\n)\n\nmodel.fit(X_train_fi, y_train)\ny_pred = model.predict(X_test_fi)\ny_pred_prob = model.predict_proba(X_test_fi)\n\n# Accuracy\nprint(f'Accuracy: {metrics.accuracy_score(y_test, y_pred):.4f}')\n\n# Precision, Recall, F1\nprint(f'Precision: {metrics.precision_score(y_test, y_pred, average=\"binary\"):.4f}')\nprint(f'Recall: {metrics.recall_score(y_test, y_pred, average=\"binary\"):.4f}')\nprint(f'F1 Score (macro): {metrics.f1_score(y_test, y_pred, average=\"macro\"):.4f}')\nprint(f'F1 Score (weighted): {metrics.f1_score(y_test, y_pred, average=\"weighted\"):.4f}')\n\n# Log loss\nprint(f'Log Loss: {metrics.log_loss(y_test, y_pred_prob):.4f}')\n\n# Classification report\nprint(\"\\nClassification Report:\")\nprint(metrics.classification_report(y_test, y_pred, digits=4))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-05-18T03:25:11.878919Z","iopub.execute_input":"2025-05-18T03:25:11.879488Z","iopub.status.idle":"2025-05-18T03:25:15.975189Z","shell.execute_reply.started":"2025-05-18T03:25:11.879463Z","shell.execute_reply":"2025-05-18T03:25:15.974509Z"}},"outputs":[{"name":"stdout","text":"Accuracy: 0.6752\nPrecision: 0.6621\nRecall: 0.7156\nF1 Score (macro): 0.6747\nF1 Score (weighted): 0.6747\nLog Loss: 0.7169\n\nClassification Report:\n              precision    recall  f1-score   support\n\n           0     0.6906    0.6348    0.6615   1373014\n           1     0.6621    0.7156    0.6878   1373013\n\n    accuracy                         0.6752   2746027\n   macro avg     0.6763    0.6752    0.6747   274602