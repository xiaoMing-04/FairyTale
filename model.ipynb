   "source": [
    "# Chuyển đổi X_train_fn và y_train thành CuPy arrays\n",
    "X_train_fn_cp = cp.array(X_train_fn)\n",
    "y_train_cp = cp.array(y_train)\n",
    "\n",
    "# Tính max_features và chuyển đổi nó thành số nguyên\n",
    "max_features = int(cp.sqrt(X_train_fn_cp.shape[1]))\n",
    "\n",
    "# Khởi tạo và huấn luyện mô hình RandomForest\n",
    "model = RandomForest(\n",
    "        n_trees=200,\n",
    "        max_features=max_features,\n",
    "        max_depth=20\n",
    ")\n",
    "model.fit(X_train_fn_cp, y_train_cp)"
   ]
