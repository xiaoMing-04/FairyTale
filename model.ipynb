    "    X_test_pca_tf = pca.transform(X_test_pca)\n",
    "\n",
    "    start = time.time()\n",
    "    model = XGBClassifier(\n",
    "        objective='binary:logistic',\n",
    "        tree_method='hist',\n",
    "        device='cuda',\n",
    "        use_label_encoder=False,\n",
    "        eval_metric='logloss',\n",
    "        subsample=1.0,\n",
    "        reg_lambda=2.5,\n",
