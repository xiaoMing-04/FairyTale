pred\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0minput_name\u001b[0m\u001b[0;34m=\u001b[0m\u001b[0;34m\"y_pred\"\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n","\u001b[0;32m/usr/local/lib/python3.11/dist-packages/sklearn/utils/validation.py\u001b[0m in \u001b[0;36mcheck_consistent_length\u001b[0;34m(*arrays)\u001b[0m\n\u001b[1;32m    395\u001b[0m     \u001b[0muniques\u001b[0m \u001b[0;34m=\u001b[0m \u001b[0mnp\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0munique\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mlengths\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m    396\u001b[0m     \u001b[0;32mif\u001b[0m \u001b[0mlen\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0muniques\u001b[0m\u001b[0;34m)\u001b[0m \u001b[0;34m>\u001b[0m \u001b[0;36m1\u001b[0m\u001b[0;34m:\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m--> 397\u001b[0;31m         raise ValueError(\n\u001b[0m\u001b[1;32m    398\u001b[0m             \u001b[0;34m\"Found input variables with inconsistent numbers of samples: %r\"\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m    399\u001b[0m             \u001b[0;34m%\u001b[0m \u001b[0;34m[\u001b[0m\u001b[0mint\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0ml\u001b[0m\u001b[0;34m)\u001b[0m \u001b[0;32mfor\u001b[0m \u001b[0ml\u001b[0m \u001b[0;32min\u001b[0m \u001b[0mlengths\u001b[0m\u001b[0;34m]\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n","\u001b[0;31mValueError\u001b[0m: Found input variables with inconsistent numbers of samples: [8085794, 3313496]"],"ename":"ValueError","evalue":"Found input variables with inconsistent numbers of samples: [8085794, 3313496]","output_type":"error"}],"execution_count":6},{"id":"947297e4-187b-4355-8094-c10f4b242fc9","cell_type":"code","source":"","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"a6391183-004a-4a85-870d-99afbb170fd7","cell_type":"code","source":"","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"99c4b32e","cell_type":"markdown","source":"# 14. Code Tay 2 Thuật Toán Machine Learning","metadata":{}},{"id":"133e07d7-4fd2-4db1-93b7-34a3df62e6d8","cell_type":"code","source":"import cupy as cp\nimport numpy as np\nfrom collections import Counter\nimport math","metadata":{"execution":{"iopub.execute_input":"2025-05-11T10:10:21.079408Z","iopub.status.busy":"2025-05-11T10:10:21.079162Z","iopub.status.idle":"2025-05-11T10:10:21.082861Z","shell.execute_reply":"2025-05-11T10:10:21.082232Z","shell.execute_reply.started":"2025-05-11T10:10:21.079386Z"}},"outputs":[],"execution_count":8},{"id":"ee04009b","cell_type":"markdown","source":"## 13.1. Logistic Regression","metadata":{}},{"id":"5340d9ac","cell_type":"markdown","source":"###  **Tóm tắt**\n\n* `lr`: learning rate.\n* `n_iters`: số vòng lặp cập nhật tham số.\n* `weights`: vector trọng số $\\mathbf{w} \\in \\mathbb{R}^d$.\n* `bias`: hệ số chệch $b \\in \\mathbb{R}$.\n* Dùng **hàm sigmoid** để đưa đầu ra về khoảng (0, 1).\n* Dùng **Gradient Descent** để cập nhật tham số.\n\n---\n\n###  **Công thức toán học**\n\nGiả sử:\n\n* $X \\in \\mathbb{R}^{n \\times d}$: ma trận đặc trưng (n mẫu, d đặc trưng).\n* $y \\in \\{0, 1\\}^n$: vector nhãn.\n\n---\n\n#### 1. **Hàm Sigmoid:**\n\n$$\n\\hat{y} = \\sigma(X\\mathbf{w} + b) = \\frac{1}{1 + e^{-(X\\mathbf{w} + b)}}\n$$\n\n---\n\n#### 2. **Hàm mất mát (Binary Cross-Entropy):**\n\n$$\n\\mathcal{L} = -\\frac{1}{n} \\sum_{i=1}^n \\left[ y_i \\log(\\hat{y}_i) + (1 - y_i) \\log(1 - \\hat{y}_i) \\right]\n$$\n\n> Lưu ý: Hàm mất mát không được tính rõ ràng trong code này, nhưng đạo hàm của nó được dùng để tính gradient.\n\n---\n\n#### 3. **Gradient:**\n\n* Gradient theo trọng số:\n\n  $$\n  \\nabla_{\\mathbf{w}} = \\frac{1}{n} X^T (\\hat{y} - y)\n  $$\n* Gradient theo bias:\n\n  $$\n  \\nabla_b = \\frac{1}{n} \\sum_{i=1}^n (\\hat{y}_i - y_i)\n  $$\n\n---\n\n#### 4. **Gradient Descent:**\n\n$$\n\\mathbf{w} \\leftarrow \\mathbf{w} - \\eta \\cdot \\nabla_{\\mathbf{w}}\n$$\n\n$$\nb \\leftarrow b - \\eta \\cdot \\nabla_b\n$$\n\nvới $\\eta = \\text{learning rate}$\n\n---\n\n#### 5. **Dự đoán xác suất:**\n\n$$\nP(X) = \\hat{y} = \\sigma(X\\mathbf{w} + b)\n$$\n\n---\n\n#### 6. **Dự đoán nhãn nhị phân:**\n\n$$\n\\text{predict}(X) = \\begin{cases}\n1 & \\text{nếu } \\hat{y} \\geq 0.5 \\\\\n0 & \\text{nếu } \\hat{y} < 0.5\n\\end{cases}\n$$","metadata":{}},{"id":"e45db5c7-13b2-430a-bcad-2dfd6629059e","cell_type":"code","source":"# --- Logistic Regression ---\nclass LogisticRegression:\n    def __init__(self, lr=0.01, n_iters=1000):\n        self.lr = lr\n        self.n_iters = n_iters\n        self.weights = None\n        self.bias = None\n\n    def sigmoid(self, z):\n        return 1 / (1 + cp.exp(-z))\n\n    def fit(self, X, y):\n        if not isinstance(X, cp.ndarray): X = cp.array(X)\n        if not isinstance(y, cp.ndarray): y = cp.array(y)\n        n_samples, n_features = X.shape\n        self.weights = cp.zeros(n_features)\n        self.bias = 0\n\n        for _ in range(self.n_iters):\n            linear_model = X @ self.weights + self.bias\n            y_pred = self.sigmoid(linear_model)\n\n            dw = (1 / n_samples) * X.T @ (y_pred - y)\n            db = (1 / n_samples) * cp.sum(y_pred - y)\n\n            self.weights -= self.lr * dw\n            self.bias -= self.lr * db\n\n    def predict_proba(self, X):\n        if not isinstance(X, cp.ndarray): X = cp.array(X)\n        linear_model = X @ self.weights + self.bias\n        return self.sigmoid(linear_model)\n\n    def predict(self, X):\n        if not isinstance(X, cp.ndarray): X = cp.array(X)\n        y_pred = self.predict_proba(X)\n        return (y_pred >= 0.5).astype(cp.int32)","metadata":{"execution":{"iopub.execute_input":"2025-05-11T06:15:23.982868Z","iopub.status.busy":"2025-05-11T06:15:23.982382Z","iopub.status.idle":"2025-05-11T06:15:23.989540Z","shell.execute_reply":"2025-05-11T06:15:23.988698Z","shell.execute_reply.started":"2025-05-11T06:15:23.982847Z"}},"outputs":[],"execution_count":27},{"id":"5ab1f9bb-166c-473c-a125-54a9f47242cc","cell_type":"code","source":"model = LogisticRegression()\nmodel.fit(X_train_fn, y_train)","metadata":{"execution":{"iopub.execute_input":"2025-05-11T06:15:29.394571Z","iopub.status.busy":"2025-05-11T06:15:29.394312Z","iopub.status.idle":"2025-05-11T06:18:37.983745Z","shell.execute_reply":"2025-05-11T06:18:37.982965Z","shell.execute_reply.started":"2025-05-11T06:15:29.394552Z"}},"outputs":[],"execution_count":28},{"id":"6b6c90b7-3be1-4b5a-af7e-b305435ea0a8","cell_type":"code","source":"y_pred = model.predict(X_test_fn).get()\ny_pred_prob = model.predict_proba(X_test_fn).get()\n\n# Accuracy\nprint(f'Accuracy: {metrics.accuracy_score(y_test, y_pred):.4f}')\n\n# Precision, Recall, F1\nprint(f'Precision: {metrics.precision_score(y_test, y_pred, average=\"binary\"):.4f}')\nprint(f'Recall: {metrics.recall_score(y_test, y_pred, average=\"binary\"):.4f}')\nprint(f'F1 Score (macro): {metrics.f1_score(y_test, y_pred, average=\"macro\"):.4f}')\nprint(f'F1 Score (weighted): {metrics.f1_score(y_test, y_pred, average=\"weighted\"):.4f}')\n\n# Log loss\nprint(f'Log Loss: {metrics.log_loss(y_test, y_pred_prob):.4f}')\n\n# Classification report\nprint(\"\\nClassification Report:\")\nprint(metrics.classification_report(y_test, y_pred, digits=4))","metadata":{"execution":{"iopub.execute_input":"2025-05-11T06:21:36.477207Z","iopub.status.busy":"2025-05-11T06:21:36.476486Z","iopub.status.idle":"2025-05-11T06:21:39.719456Z","shell.execute_reply":"2025-05-11T06:21:39.718779Z","shell.execute_reply.started":"2025-05-11T06:21:36.477183Z"}},"outputs":[{"name":"stdout","output_type":"stream","text":["Accuracy: 0.6729\n","Precision: 0.6296\n","Recall: 0.8403\n","F1 Score (macro): 0.6635\n","F1 Score (weighted): 0.6635\n","Log Loss: 0.6271\n","\n","Classification Report:\n","              precision    recall  f1-score   support\n","\n","           0     0.7599    0.5055    0.6072   1373014\n","           1     0.6296    0.8403    0.7198   1373013\n","\n","    accuracy                         0.6729   2746027\n","   macro avg     0.6947    0.6729    0.6635   2746027\n","weighted avg     0.6947    0.6729    0.6635   2746027\n","\n"]}],"execution_count":34},{"id":"186197c7","cell_type":"markdown","source":"So với mô hình trong module có sẵn thì mô hình code tay cho kết quả tương đương.","metadata":{}},{"id":"f475c980-d936-4280-9a0d-e31719d4d6a7","cell_type":"code","source":"plot_recall_precision_matrices(y_test, y_pred, [1, 0], 'plasma')","metadata":{"execution":{"iopub.execute_input":"2025-05-11T06:21:54.148651Z","iopub.status.busy":"2025-05-11T06:21:54.148388Z","iopub.status.idle":"2025-05-11T06:21:57.513039Z","shell.execute_reply":"2025-05-11T06:21:57.512302Z","shell.execute_reply.started":"2025-05-11T06:21:54.148630Z"}},"outputs":[{"data":{"image/png":"","text/plain":["<Figure size 1600x500 with 6 Axes>"]},"metadata":{},"output_type":"display_data"}],"execution_count":35},{"id":"a730b34f-dc81-4acf-9f67-f02bfef0b472","cell_type":"code","source":"three_lines_curve(y_test, np.column_stack((1 - y_pred_prob, y_pred_prob)))","metadata":{"execution":{"iopub.execute_input":"2025-05-11T06:26:07.324069Z","iopub.status.busy":"2025-05-11T06:26:07.323796Z","iopub.status.idle":"2025-05-11T06:26:16.986690Z","shell.execute_reply":"2025-05-11T06:26:16.985978Z","shell.execute_reply.started":"2025-05-11T06:26:07.324049Z"}},"outputs":[{"data":{"image/png":"","text/plain":["<Figure size 1000x600 with 1 Axes>"]},"metadata":{},"output_type":"display_data"}],"execution_count":46},{"id":"51f41a6c-02b3-4ad3-b1d3-1b5a4d6b0765","cell_type":"code","source":"roc_auc(y_test, np.column_stack((1 - y_pred_prob, y_pred_prob)))","metadata":{"execution":{"iopub.execute_input":"2025-05-11T06:26:50.136241Z","iopub.status.busy":"2025-05-11T06:26:50.135467Z","iopub.status.idle":"2025-05-11T06:26:51.090624Z","shell.execute_reply":"2025-05-11T06:26:51.089890Z","shell.execute_reply.started":"2025-05-11T06:26:50.136217Z"}},"outputs":[{"data":{"image/png":"","text/plain":["<Figure size 1600x800 with 1 Axes>"]},"metadata":{},"output_type":"display_data"}],"execution_count":47},{"id":"390c5164","cell_type":"markdown","source":"## 13.2. Random Forest Classifier","metadata":{}},{"id":"6baafa49","cell_type":"markdown","source":"###  TÓM TẮT CHỨC NĂNG THEO MODULE\n\n#### 1. **`bootstrap_sample(X, y)`**\n\n* Tạo mẫu bootstrap (lấy mẫu có lặp).\n* Được dùng để tạo tập huấn luyện cho mỗi cây con trong rừng.\n\n---\n\n#### 2. **`gini(labels)`**\n\n* Tính **Gini impurity**:\n\n$$\nGini = 1 - \\sum_{k=1}^{K} p_k^2\n$$\n\nTrong đó $p_k$ là xác suất nhãn lớp $k$.\n\n---\n\n#### 3. **`best_split(X, y, features)`**\n\n* Tìm feature và threshold chia tốt nhất dựa vào **Gini gain**:\n\n$$\n\\text{Gain} = \\text{Gini}(parent) - p_L \\cdot \\text{Gini}(left) - p_R \\cdot \\text{Gini}(right)\n$$\n\n* Tối ưu bằng cách tính toàn bộ threshold cùng lúc để tăng tốc.\n\n---\n\n#### 4. **`build_tree(...)`**\n\n* Đệ quy xây dựng cây quyết định.\n* Điều kiện dừng: độ sâu tối đa, kích thước nhỏ nhất, hoặc nhãn đã đồng nhất.\n* Trả về `Node`, chứa:\n\n  * `feature`, `threshold`: thông tin chia nhánh\n  * `value`: nhãn nếu là node lá\n  * `gain`: dùng để tính độ quan trọng của feature\n\n---\n\n#### 5. **`tree_predict(node, x)`**\n\n* Duyệt cây để dự đoán cho mẫu `x`.\n* Nếu gặp node lá thì trả về nhãn dự đoán.\n\n---\n\n#### 6. **`RandomForest` class**\n\n* **`fit()`**:\n\n  * Huấn luyện nhiều cây từ các mẫu bootstrap.\n  * Gọi `build_tree` nhiều lần và lưu cây vào `self.trees`.\n  * Tính `feature_importances_` bằng tổng gain tại mỗi node.\n* **`predict(X)`**:\n\n  * Dự đoán nhãn theo **majority voting** từ tất cả cây.\n* **`predict_proba(X)`**:\n\n  * Trả về xác suất dựa trên tỷ lệ vote cho mỗi lớp từ các cây.\n\n---\n\n### CÔNG THỨC CHÍNH TRONG RANDOM FOREST\n\n1. **Gini impurity**:\n\n$$\nGini(S) = 1 - \\sum_{c \\in \\text{classes}} p_c^2\n$$\n\n2. **Gini Gain**:\n\n$$\n\\text{Gain} = Gini(S) - \\frac{|S_L|}{|S|} Gini(S_L) - \\frac{|S_R|}{|S|} Gini(S_R)\n$$\n\n3. **Majority Vote (Dự đoán nhãn)**:\n\n$$\n\\hat{y} = \\text{mode} \\left( \\{ h_i(x) \\}_{i=1}^{n\\_trees} \\right)\n$$\n\n4. **Feature importance**:\n\n$$\n\\text{Importance}(f_j) = \\sum_{\\text{node có feature } f_j} \\text{Gini Gain tại node}\n$$","metadata":{}},{"id":"272c175a-9711-4443-9cee-ed7718585f0c","cell_type":"code","source":"# --- 1. Bootstrap sampling ---\ndef bootstrap_sample(X, y, random_state=None):\n    if X.size == 0 or y.size == 0 or len(X) != len(y):\n        raise ValueError(\"Invalid input data: X and y must be non-empty and have the same length\")\n    n = len(X)\n    rng = np.random.default_rng(random_state)\n    indices = rng.choice(n, size=n, replace=True)\n    return X[indices], y[indices]\n\n# --- 2. Gini Impurity ---\ndef gini(labels):\n    if len(labels) == 0:\n        return 0.0\n    labels_sorted = cp.sort(labels)\n    idx = cp.where(labels_sorted[1:] != labels_sorted[:-1])[0] + 1\n    counts = cp.diff(cp.concatenate([cp.array([0]), idx, cp.array([len(labels_sorted)])]))\n    probs = counts / len(labels)\n    return 1.0 - cp.sum(probs ** 2)\n\n# --- 3. Tối ưu `best_split` ---\ndef best_split(X, y, features):\n    best_feature, best_thresh, best_gain = None, None, 0\n    base_impurity = gini(y)\n    n = len(y)\n\n    # Tính split và Gini cho mỗi feature\n    for feat in features:\n        values = cp.unique(X[:, feat])\n        \n        # Giới hạn số lượng giá trị duy nhất nếu quá lớn\n        if len(values) > 50:\n            values = cp.percentile(values, cp.linspace(0, 100, 50))\n\n        thresholds = (values[:-1] + values[1:]) / 2\n        left_mask = X[:, feat] <= thresholds[:, None]\n        right_mask = ~left_mask\n\n        # Tính Gini cho tất cả ngưỡng một lần\n        left_impurity = cp.sum(left_mask * gini(y[:, None]), axis=1)\n        right_impurity = cp.sum(right_mask * gini(y[:, None]), axis=1)\n\n        p_left = cp.sum(left_mask, axis=1) / n\n        p_right = 1 - p_left\n\n        gain = base_impurity - p_left * left_impurity - p_right * right_impurity\n\n        # Tìm ngưỡng tốt nhất\n        max_gain_idx = cp.argmax(gain)\n        if gain[max_gain_idx] > best_gain:\n            best_gain = gain[max_gain_idx]\n            best_feature = feat\n            best_thresh = thresholds[max_gain_idx]\n\n    return best_feature, best_thresh, best_gain\n\n# --- 4. Cấu trúc Node và xây dựng cây quyết định ---\nclass Node:\n    def __init__(self, feature=None, threshold=None, left=None, right=None, value=None, gain=None):\n        self.feature = feature\n        self.threshold = threshold\n        self.left = left\n        self.right = right\n        self.value = value\n        self.gain = gain\n\ndef build_tree(X, y, max_features, max_depth, min_size, depth=0):\n    if not X.size or not y.size:\n        return Node(value=None)\n    if depth >= max_depth or len(y) <= min_size or len(cp.unique(y)) == 1:\n        return Node(value=Counter(cp.asnumpy(y)).most_common(1)[0][0] if y.size > 0 else None)\n    features = np.random.choice(X.shape[1], max_features, replace=False)\n    feat, thresh, gain = best_split(X, y, features)\n    if feat is None:\n        return Node(value=Counter(cp.asnumpy(y)).most_common(1)[0][0] if y.size > 0 else None)\n    left_mask = X[:, feat] <= thresh\n    left_X, left_y = X[left_mask], y[left_mask]\n    right_X, right_y = X[~left_mask], y[~left_mask]\n    left = build_tree(left_X, left_y, max_features, max_depth, min_size, depth + 1)\n    right = build_tree(right_X, right_y, max_features, max_depth, min_size, depth + 1)\n    return Node(feature=feat, threshold=thresh, left=left, right=right, gain=gain)\n\n# --- 5. Dự đoán cho cây ---\ndef tree_predict(node, x):\n    if node.value is not None:\n        return node.value\n    branch = node.left if x[node.feature] <= node.threshold else node.right\n    return tree_predict(branch, x)\n\n# --- 6. Random Forest ---\nclass RandomForest:\n    def __init__(self, n_trees=50, max_features=None, max_depth=10, min_size=5, random_state=None):\n        self.n_trees = n_trees\n        self.max_features = max_features\n        self.max_depth = max_depth\n        self.min_size = min_size\n        self.random_state = random_state\n        self.trees = []\n        self.feature_importances_ = None\n        self.classes_ = None\n\n    def fit(self, X, y):\n        if not isinstance(X, cp.ndarray):\n            X = cp.array(X)\n        if not isinstance(y, cp.ndarray):\n            y = cp.array(y)\n        if X.shape[0] != y.shape[0]:\n            raise ValueError(\"X and y must have the same number of samples\")\n        self.trees = []\n        self.feature_importances_ = cp.zeros(X.shape[1])\n        if self.max_features is None:\n            self.max_features = int(cp.sqrt(X.shape[1]))\n        if self.max_features <= 0 or self.max_features > X.shape[1]:\n            raise ValueError(\"max_features must be between 1 and number of features\")\n        self.classes_ = cp.unique(y)\n\n        for i in tqdm(range(self.n_trees)):\n            X_samp, y_samp = bootstrap_sample(X, y,\n                                              self.random_state + i if self.random_state is not None else None)\n            tree = build_tree(X_samp, y_samp, self.max_features, self.max_depth, self.min_size)\n            self.trees.append(tree)\n            self._compute_feature_importance(tree, X.shape[1])\n\n    def _compute_feature_importance(self, node, n_features):\n        if node is None or node.value is not None:\n            return\n        if node.feature is not None and node.gain is not None:\n            self.feature_importances_[node.feature] += node.gain\n        self._compute_feature_importance(node.left, n_features)\n        self._compute_feature_importance(node.right, n_features)\n\n    def predict(self, X):\n        if not isinstance(X, cp.ndarray):\n            X = cp.array(X)\n        predictions = []\n        for x in X:\n            votes = [tree_predict(t, x) for t in self.trees]\n            predictions.append(Counter(votes).most_common(1)[0][0])\n        return cp.array(predictions)\n\n    def predict_proba(self, X):\n        if not isinstance(X, cp.ndarray):\n            X = cp.array(X)\n        probs = []\n        for x in X:\n            votes = [tree_predict(t, x) for t in self.trees]\n            vote_counts = Counter(votes)\n            \n            # Chuyển self.classes_ thành list hoặc tuple để sử dụng với Counter\n            prob = [vote_counts.get(c, 0) / self.n_trees for c in list(self.classes_)]\n            probs.append(prob)\n        return cp.array(probs)","metadata":{"execution":{"iopub.execute_input":"2025-05-11T10:47:45.051136Z","iopub.status.busy":"2025-05-11T10:47:45.050382Z","iopub.status.idle":"2025-05-11T10:47:45.071959Z","shell.execute_reply":"2025-05-11T10:47:45.071199Z","shell.execute_reply.started":"2025-05-11T10:47:45.051104Z"}},"outputs":[],"execution_count":29},{"id":"e7272728-ad83-44e3-adee-03c182792028","cell_type":"code","source":"# Chuyển đổi X_train_fn và y_train thành CuPy arrays\nX_train_fn_cp = cp.array(X_train_fn)\ny_train_cp = cp.array(y_train)\n\n# Tính max_features và chuyển đổi nó thành số nguyên\nmax_features = int(cp.sqrt(X_train_fn_cp.shape[1]))\n\n# Khởi tạo và huấn luyện mô hình RandomForest\nmodel = RandomForest(\n        n_trees=200,\n        max_features=max_features,\n        max_depth=20\n)\nmodel.fit(X_train_fn_cp, y_train_cp)","metadata":{"execution":{"iopub.execute_input":"2025-05-11T10:25:42.515304Z","iopub.status.busy":"2025-05-11T10:25:42.515034Z","iopub.status.idle":"2025-05-11T10:39:53.795619Z","shell.execute_reply":"2025-05-11T10:39:53.795043Z","shell.execute_reply.started":"2025-05-11T10:25:42.515283Z"}},"outputs":[{"name":"stderr","output_type":"stream","text":["100%|██████████| 200/200 [14:10<00:00,  4.25s/it]\n"]}],"execution_count":20},{"id":"49c8a369-7019-45cc-8beb-8f3812c01426","cell_type":"code","source":"y_pred = model.predict(X_test_fn).get()\n# y_pred_prob = model.predict_proba(X_test_fn).get()\n\n# Accuracy\nprint(f'Accuracy: {metrics.accuracy_score(y_test, y_pred):.4f}')\n\n# Precision, Recall, F1\nprint(f'Precision: {metrics.precision_score(y_test, y_pred, average=\"binary\"):.4f}')\nprint(f'Recall: {metrics.recall_score(y_test, y_pred, average=\"binary\"):.4f}')\nprint(f'F1 Score (macro): {metrics.f1_score(y_test, y_pred, average=\"macro\"):.4f}')\nprint(f'F1 Score (weighted): {metrics.f1_score(y_test, y_pred, average=\"weighted\"):.4f}')\n\n# Log loss\n# print(f'Log Loss: {metrics.log_loss(y_test, y_pred_prob):.4f}')\n\n# Classification report\nprint(\"\\nClassification Report:\")\nprint(metrics.classification_report(y_test, y_pred, digits=4))","metadata":{"execution":{"iopub.execute_input":"2025-05-11T10:47:19.630397Z","iopub.status.busy":"2025-05-11T10:47:19.629728Z","iopub.status.idle":"2025-05-11T10:47:21.913852Z","shell.execute_reply":"2025-05-11T10:47:21.913151Z","shell.execute_reply.started":"2025-05-11T10:47:19.630371Z"}},"outputs":[{"name":"stdout","output_type":"stream","text":["Accuracy: 0.5000\n","Precision: 0.5000\n","Recall: 1.0000\n","F1 Score (macro): 0.3333\n","F1 Score (weighted): 0.3333\n","\n","Classification Report:\n"]},{"name":"stderr","output_type":"stream","text":["/usr/local/lib/python3.11/dist-packages/sklearn/metrics/_classification.py:1344: UndefinedMetricWarning: Precision and F-score are ill-defined and being set to 0.0 in labels with no predicted samples. Use `zero_division` parameter to control this behavior.\n","  _warn_prf(average, modifier, msg_start, len(result))\n","/usr/local/lib/python3.11/dist-packages/sklearn/metrics/_classification.py:1344: UndefinedMetricWarning: Precision and F-score are ill-defined and being set to 0.0 in labels with no predicted samples. Use `zero_division` parameter to control this behavior.\n","  _warn_prf(average, modifier, msg_start, len(result))\n"]},{"name":"stdout","output_type":"stream","text":["