ee=None, device=&#x27;cuda&#x27;, early_stopping_rounds=None,\n              enable_categorical=False, eval_metric=&#x27;logloss&#x27;,\n              feature_types=None, gamma=None, grow_policy=None,\n              importance_type=None, interaction_constraints=None,\n              learning_rate=0.05, max_bin=None, max_cat_threshold=None,\n              max_cat_to_onehot=None, max_delta_step=None, max_depth=8,\n              max_leaves=None, min_child_weight=None, missing=nan,\n              monotone_constraints=None, multi_strategy=None, n_estimators=500,\n              n_jobs=None, num_parallel_tree=None, random_state=None, ...)</pre></div></div></div></div></div></div></div></div></div></div>"},"metadata":{}}],"execution_count":16},{"id":"3b51dfb2","cell_type":"code","source":"y_pred = calibrated_model.predict(X_test)\ny_pred_prob = calibrated_model.predict_proba(X_test)\n\n# Accuracy\nprint(f'Accuracy: {metrics.accuracy_score(y_test, y_pred):.4f}')\n\n# Precision, Recall, F1\nprint(f'Precision: {metrics.precision_score(y_test, y_pred, average=\"binary\"):.4f}')\nprint(f'Recall: {metrics.recall_score(y_test, y_pred, average=\"binary\"):.4f}')\nprint(f'F1 Score (macro): {metrics.f1_score(y_test, y_pred, average=\"macro\"):.4f}')\nprint(f'F1 Score (weighted): {metrics.f1_score(y_test, y_pred, average=\"weighted\"):.4f}')\n\n# Log loss\nprint(f'Log Loss: {metrics.log_loss(y_test, y_pred_prob):.4f}')\n\n# Classification report\nprint(\"\\nClassification Report:\")\nprint(metrics.classification_report(y_test, y_pred, digits=4))","metadata":{"execution":{"iopub.status.busy":"2025-05-18T01:23:49.007608Z","iopub.execute_input":"2025-05-18T01:23:49.008386Z","iopub.status.idle":"2025-05-18T01:24:18.769082Z","shell.execute_reply.started":"2025-05-18T01:23:49.008361Z","shell.execute_reply":"2025-05-18T01:24:18.768249Z"},"id":"11c1d08b","outputId":"a8738ad2-054c-4fac-e251-af3e1feee3ed","papermill":{"duration":null,"end_time":null,"exception":null,"start_time":null,"status":"pending"},"tags":[],"trusted":true},"outputs":[{"name":"stdout","text":"Accuracy: 0.8204\nPrecision: 0.4372\nRecall: 0.2030\nF1 Score (macro): 0.5873\nF1 Score (weighted): 0.7922\nLog Loss: 0.5019\n\nClassification Report:\n              precision    recall  f1-score   support\n\n           0     0.8532    0.9466    0.8975   2490853\n           1     0.4372    0.2030    0.2772    509147\n\n    accuracy                         0.8204   3000000\n   macro avg     0.6452    0.5748    0.5873   3000000\nweighted avg     0.7826    0.8204    0.7922   3000000\n\n","output_type":"stream"}],"execution_count":17},{"id":"b7814cd4","cell_type":"markdown","source":"So với mô hình `Random Forest`, thì `XGB` cho chúng ta một kết quả tương tự.","metadata":{}},{"id":"48ed5256","cell_type":"code","source":"plot_recall_precision_matrices(y_test, y_pred, [1, 0], 'plasma')","metadata":{"execution":{"iopub.status.busy":"2025-05-18T01:24:27.379670Z","iopub.execute_input":"2025-05-18T01:24:27.380233Z","iopub.status.idle":"2025-05-18T01:24:31.760191Z","shell.execute_reply.started":"2025-05-18T01:24:27.380213Z","shell.execute_reply":"2025-05-18T01:24:31.759385Z"},"id":"19b3fdd8","outputId":"3cc14e0a-fb24-4ae0-daf7-0f4a6b565121","papermill":{"duration":null,"end_time":null,"exception":null,"start_time":null,"status":"pending"},"tags":[],"trusted":true},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1600x500 with 6 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":18},{"id":"0c1553f3","cell_type":"code","source":"three_lines_curve(y_test, y_pred_prob)","metadata":{"execution":{"iopub.status.busy":"2025-05-18T01:24:31.761597Z","iopub.execute_input":"2025-05-18T01:24:31.761816Z","iopub.status.idle":"2025-05-18T01:24:38.194659Z","shell.execute_reply.started":"2025-05-18T01:24:31.761800Z","shell.execute_reply":"2025-05-18T01:24:38.193933Z"},"id":"59b5451b","outputId":"9d91e7d0-ea10-4514-8cb1-fa04871f5326","papermill":{"duration":null,"end_time":null,"exception":null,"start_time":null,"status":"pending"},"tags":[],"trusted":true},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1000x600 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":19},{"id":"2e1bed73","cell_type":"code","source":"roc_auc(y_test, y_pred_prob)","metadata":{"execution":{"iopub.status.busy":"2025-05-18T01:24:38.195482Z","iopub.execute_input":"2025-05-18T01:24:38.195728Z","iopub.status.idle":"2025-05-18T01:24:39.280739Z","shell.execute_reply.started":"2025-05-18T01:24:38.195711Z","shell.execute_reply":"2025-05-18T01:24:39.279961Z"},"id":"e69202ea","outputId":"8e7abfd9-d323-49f2-e314-1e4364e41630","papermill":{"duration":null,"end_time":null,"exception":null,"start_time":null,"status":"pending"},"tags":[],"trusted":true},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1600x800 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":20},{"id":"a9083029","cell_type":"markdown","source":"Đường cong `roc` cũng giống hệt như `Random Forest Classifier`.","metadata":{}},{"id":"354f6853","cell_type":"markdown","source":"# 9. Modeling with Hyperparamater Tuning","metadata":{}},{"id":"1b94870d","cell_type":"markdown","source":"Chúng ta sẽ tiến hành điều chỉnh tham số của các mô hình máy học (Hyperparamater Tuning).\n\nVì chúng ta sử dụng thư viện `cuml`, một thư viện cung cấp các mô hình máy học tương tự như `sklearn` nhưng khác ở chỗ chúng được huấn luyện trên `GPU`, giúp tăng tốc thời gian huấn luyện lên rất nhiều lần, nên việc kết hợp với thư viện `GridSearch` hay `RandomizedSearch` trong thư viện `sklearn` sẽ gây ra lỗi, chúng ta sẽ phải viết code search bằng tay.","metadata":{}},{"id":"ecb46520","cell_type":"markdown","source":"## 9.1. Logistic Regression","metadata":{"id":"da56451e-c3a5-47f8-b96d-cbbb95acc4a3"}},{"id":"64b66785","cell_type":"code","source":"from itertools import product","metadata":{"execution":{"iopub.execute_input":"2025-05-09T16:47:49.308421Z","iopub.status.busy":"2025-05-09T16:47:49.307885Z","iopub.status.idle":"2025-05-09T16:47:49.312041Z","shell.execute_reply":"2025-05-09T16:47:49.311268Z","shell.execute_reply.started":"2025-05-09T16:47:49.308394Z"}},"outputs":[],"execution_count":10},{"id":"43a71e2b","cell_type":"code","source":"param_grid = {\n    'C': np.linspace(0.01, 3, 10),\n    'penalty': ['l1', 'l2'],\n    'class_weight': [None, 'balanced', {0: 1, 1: 5.25}],\n    'fit_intercept': [True, False]\n}\n\nparam_list = list(product(\n    param_grid['C'],\n    param_grid['penalty'],\n    param_grid['class_weight'],\n    param_grid['fit_intercept']\n))\n\nprint(len(param_list))","metadata":{"execution":{"iopub.execute_input":"2025-05-09T16:47:49.312856Z","iopub.status.busy":"2025-05-09T16:47:49.312646Z","iopub.status.idle":"2025-05-09T16:47:49.325664Z","shell.execute_reply":"2025-05-09T16:47:49.324956Z","shell.execute_reply.started":"2025-05-09T16:47:49.312831Z"},"id":"6bfa9553-b6f1-4b0d-9c90-0b3dbe08f236"},"outputs":[{"name":"stdout","output_type":"stream","text":["120\n"]}],"execution_count":11},{"id":"c5bf037d","cell_type":"code","source":"skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\nresults = []\n\nfor C, penalty, class_weight, fit_intercept in tqdm(param_list):\n    log_losses = []\n    for train_idx, val_idx in skf.split(X_train, y_train):\n        X_tr, X_val = X_train.iloc[train_idx], X_train.iloc[val_idx]\n        y_tr, y_val = np.ravel(y_train.iloc[train_idx]), np.ravel(y_train.iloc[val_idx])\n\n\n        if penalty != 'l2':\n            continue\n\n        model = LogisticRegression(\n            solver='qn',\n            penalty=penalty,\n            class_weight=class_weight,\n            C=C,\n            fit_intercept=fit_intercept,\n            max_iter=5000\n        )\n\n        model.fit(X_tr, y_tr)\n        y_proba = model.predict_proba(X_val).iloc[:, 1]\n        loss = metrics.log_loss(y_val, y_proba)\n        log_losses.append(loss)\n\n        del model, y_proba\n        gc.collect()\n\n    if log_losses:\n        avg_loss = np.mean(log_losses)\n        results.append(((C, penalty, class_weight, fit_intercept), avg_loss))","metadata":{"execution":{"iopub.execute_input":"2025-05-09T17:02:58.619389Z","iopub.status.busy":"2025-05-09T17:02:58.619013Z","iopub.status.idle":"2025-05-09T18:13:46.991712Z","shell.execute_reply":"2025-05-09T18:13:46.990944Z","shell.execute_reply.started":"2025-05-09T17:02:58.619363Z"},"id":"3edff510-5768-4cc2-8c8c-ab16a5d6a379","outputId":"7573554a-2985-46c3-a942-045ff3d3bbb4"},"outputs":[{"name":"stderr","output_type":"stream","text":["  5%|▌         | 6/120 [01:01<19:23, 10.20s/it]"]},{"name":"stdout","output_type":"stream","text":["[2025-05-09 17:04:23.881] [CUML] [warning] L-BFGS stopped, because the line search failed to advance (step delta = 0.000000)\n","[2025-05-09 17:04:42.570] [CUML] [warning] L-BFGS stopped, because the line search failed to advance (step delta = 0.000000)\n"]},{"name":"stderr","output_type":"stream","text":["  6%|▌         | 7/120 [01:53<44:54, 23.84s/it]"]},{"name":"stdout","output_type":"stream","text":["[2025-05-09 17:05:06.686] [CUML] [warning] L-BFGS stopped, because the line search failed to advance (step delta = 0.000000)\n","[2025-05-09 17:05:38.270] [CUML] [warning] L-BFGS stopped, because the line search failed to advance (step delta = 0.000000)\n"]},{"name":"stderr","output_type":"stream","text":["  7%|▋         | 8/120 [02:40<58:28, 31.33s/it]"]},{"name":"stdout","output_type":"stream","text":["[2025-05-09 17:05:59.837] [CUML] [warning] L-BFGS stopped, because the line search failed to advance (step delta = 0.000000)\n","[2025-05-09 17:06:09.837] [CUML] [warning] L-BFGS stopped, because the line search failed to advance (step delta = 0.000000)\n"]},{"name":"stderr","output_type":"stream","text":["  8%|▊         | 9/120 [03:32<1:09:52, 37.77s/it]"]},{"name":"stdout","output_type":"stream","text":["[2025-05-09 17:06:58.961] [CUML] [warning] L-BFGS stopped, because the line search f