s.busy":"2025-05-18T01:12:27.116653Z","iopub.execute_input":"2025-05-18T01:12:27.117246Z","iopub.status.idle":"2025-05-18T01:12:37.337432Z","shell.execute_reply.started":"2025-05-18T01:12:27.117223Z","shell.execute_reply":"2025-05-18T01:12:37.336665Z"},"id":"a59c78dd","outputId":"87eff72e-2534-4529-b6a6-f58caf9dda95","papermill":{"duration":3.422242,"end_time":"2025-04-07T13:41:52.976327","exception":false,"start_time":"2025-04-07T13:41:49.554085","status":"completed"},"tags":[],"trusted":true},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1000x600 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":10},{"id":"42cbe3f2","cell_type":"markdown","source":"Với mức `threshold` là 0.6, thì cả 2 chỉ số đặt ở mức cân bằng và bằng nhau. Nhưng dù tăng hay giảm `threshold` thì một trong 2 chỉ số sẽ tăng lên, còn chỉ số còn lại sẽ giảm theo hướng ngược lại.","metadata":{}},{"id":"b1210045","cell_type":"code","source":"roc_auc(y_test, y_pred_prob)","metadata":{"execution":{"iopub.status.busy":"2025-05-18T01:12:37.338511Z","iopub.execute_input":"2025-05-18T01:12:37.338740Z","iopub.status.idle":"2025-05-18T01:12:38.520162Z","shell.execute_reply.started":"2025-05-18T01:12:37.338723Z","shell.execute_reply":"2025-05-18T01:12:38.519374Z"},"id":"273cf13e","outputId":"5b8bcbe9-aa54-4121-e176-4d1df5e379fb","papermill":{"duration":0.420937,"end_time":"2025-04-07T13:41:53.418972","exception":false,"start_time":"2025-04-07T13:41:52.998035","status":"completed"},"tags":[],"trusted":true},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1600x800 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":11},{"id":"bf525c4f","cell_type":"markdown","source":"Mô hình phân biệt được hai lớp khá ổn (ROC AUC = 0.70), nhưng hiện tại quá bảo thủ trong việc dự đoán dương tính. Nó chọn lọc kỹ, nên precision khá cao, nhưng kết quả là recall lại cực thấp. Trong thực tế, nếu bạn đang làm bài toán như phát hiện gian lận, click ads, hay phát hiện bệnh, recall thấp là rất nguy hiểm, vì mô hình sẽ bỏ sót rất nhiều trường hợp quan trọng.","metadata":{}},{"id":"ce990475","cell_type":"markdown","source":"## 8.2. Random Forest Classifier","metadata":{"id":"6dfd7a2c","papermill":{"duration":0.038808,"end_time":"2025-04-07T14:06:21.073205","exception":false,"start_time":"2025-04-07T14:06:21.034397","status":"completed"},"tags":[]}},{"id":"c064a1ae","cell_type":"code","source":"model = RandomForestClassifier()\nmodel.fit(X_train, y_train)\n\ncalibrated_model = CalibratedClassifierCV(estimator=model, cv='prefit')\ncalibrated_model.fit(X_train, y_train)\n\ny_pred = calibrated_model.predict(X_test)\ny_pred_prob = calibrated_model.predict_proba(X_test)\n\n# Accuracy\nprint(f'Accuracy: {metrics.accuracy_score(y_test, y_pred):.4f}')\n\n# Precision, Recall, F1\nprint(f'Precision: {metrics.precision_score(y_test, y_pred, average=\"binary\"):.4f}')\nprint(f'Recall: {metrics.recall_score(y_test, y_pred, average=\"binary\"):.4f}')\nprint(f'F1 Score (macro): {metrics.f1_score(y_test, y_pred, average=\"macro\"):.4f}')\nprint(f'F1 Score (weighted): {metrics.f1_score(y_test, y_pred, average=\"weighted\"):.4f}')\n\n# Log loss\nprint(f'Log Loss: {metrics.log_loss(y_test, y_pred_prob):.4f}')\n\n# Classification report\nprint(\"\\nClassification Report:\")\nprint(metrics.classification_report(y_test, y_pred, digits=4))","metadata":{"execution":{"iopub.status.busy":"2025-05-18T01:13:38.143669Z","iopub.execute_input":"2025-05-18T01:13:38.144407Z","iopub.status.idle":"2025-05-18T01:17:10.240824Z","shell.execute_reply.started":"2025-05-18T01:13:38.144382Z","shell.execute_reply":"2025-05-18T01:17:10.240042Z"},"id":"d9da48cf","outputId":"213d2700-a430-4cee-d27b-28c820490794","papermill":{"duration":null,"end_time":null,"exception":false,"start_time":"2025-04-07T14:06:21.108742","status":"running"},"tags":[],"trusted":true},"outputs":[{"name":"stdout","text":"Accuracy: 0.8212\nPrecision: 0.4382\nRecall: 0.1904\nF1 Score (macro): 0.5818\nF1 Score (weighted): 0.7908\nLog Loss: 0.4917\n\nClassification Report:\n              precision    recall  f1-score   support\n\n           0     0.8517    0.9501    0.8982   2490853\n           1     0.4382    0.1904    0.2654    509147\n\n    accuracy                         0.8212   3000000\n   macro avg     0.6449    0.5702    0.5818   3000000\nweighted avg     0.7815    0.8212    0.7908   3000000\n\n","output_type":"stream"}],"execution_count":12},{"id":"c213c58d","cell_type":"markdown","source":"Với mô hình `Random Forest`, cho thấy mô hình đã tăng số lượng dự đoán lớp dương lên để tăng `Precision`, tuy nhiên điều này lại làm giảm `Recall`. Với `log loss`, ta thấy một sự cải thiện khá đáng kể khi `log loss` bây giờ chỉ còn là `0.49`. Ngoài ra `accuracy` cũng khá ấn tượng với `0.82`. Đây là một mô hình tốt.\n\nChúng ta sẽ quan sát các đường `recall, precision` và `ROC` xem liệu mô hình này hoạt động như thế nào.","metadata":{}},{"id":"6916811b","cell_type":"code","source":"plot_recall_precision_matrices(y_test, y_pred, [1, 0], 'plasma')","metadata":{"execution":{"iopub.status.busy":"2025-05-18T01:17:23.080536Z","iopub.execute_input":"2025-05-18T01:17:23.081272Z","iopub.status.idle":"2025-05-18T01:17:28.183106Z","shell.execute_reply.started":"2025-05-18T01:17:23.081250Z","shell.execute_reply":"2025-05-18T01:17:28.182163Z"},"id":"486e7777","outputId":"3308dd5f-e591-4715-d514-32bb3cbb5433","papermill":{"duration":null,"end_time":null,"exception":null,"start_time":null,"status":"pending"},"tags":[],"trusted":true},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1600x500 with 6 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":13},{"id":"765efbb3","cell_type":"code","source":"three_lines_curve(y_test, y_pred_prob)","metadata":{"execution":{"iopub.status.busy":"2025-05-18T01:17:28.184571Z","iopub.execute_input":"2025-05-18T01:17:28.184847Z","iopub.status.idle":"2025-05-18T01:17:36.511509Z","shell.execute_reply.started":"2025-05-18T01:17:28.184828Z","shell.execute_reply":"2025-05-18T01:17:36.510486Z"},"id":"796f3284","outputId":"eb705040-4046-42cf-8dd7-5c809321c7ad","papermill":{"duration":null,"end_time":null,"exception":null,"start_time":null,"status":"pending"},"tags":[],"trusted":true},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1000x600 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":14},{"id":"a074ffd9","cell_type":"code","source":"roc_auc(y_test, y_pred_prob)","metadata":{"execution":{"iopub.status.busy":"2025-05-18T01:17:36.512353Z","iopub.execute_input":"2025-05-18T01:17:36.512625Z","iopub.status.idle":"2025-05-18T01:17:37.679447Z","shell.execute_reply.started":"2025-05-18T01:17:36.512608Z","shell.execute_reply":"2025-05-18T01:17:37.678670Z"},"id":"9946094e","outputId":"ae1e4898-61b9-4c09-e722-f0eb29869729","papermill":{"duration":null,"end_time":null,"exception":null,"start_time":null,"status":"pending"},"tags":[],"trusted":true},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1600x800 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":15},{"id":"351a9409","cell_type":"markdown","source":"Đường cong `roc` là `0.72`. Điều này chứng minh mô hình chúng ta phân biệt khá tốt giữa lớp âm và lớp dương.","metadata":{}},{"id":"a622d99f","cell_type":"markdown","source":"## 8.3. XGBoost Classifier","metadata":{"id":"cf78425e","papermill":{"duration":null,"end_time":null,"exception":null,"start_time":null,"status":"pending"},"tags":[]}},{"id":"50374d2e","cell_type":"markdown","source":"**XGBoost Classifier** là một thuật toán học máy mạnh mẽ dựa trên phương pháp **gradient boosting**, được thiết kế tối ưu về hiệu năng và tốc độ. Tên đầy đủ là **Extreme Gradient Boosting**.\n\n### Đặc điểm nổi bật:\n- **Hiệu suất cao**: Tối ưu hóa tính toán, hỗ trợ song song hóa và GPU.\n- **Chống overfitting tốt**: Nhờ các kỹ thuật regularization (L1, L2).\n- **Làm việc tốt với dữ liệu mất cân bằng** và dữ liệu có nhiều đặc trưng.\n- **Tùy biến linh hoạt**: Hỗ trợ nhiều hàm mất mát và tham số.\n\n### Ứng dụng:\n- Phân loại nhị phân và đa lớp (ví dụ: chẩn đoán bệnh, phân loại khách hàng, phát hiện gian lận).\n- Đạt nhiều thành tích cao trong các cuộc thi Kaggle.","metadata":{}},{"id":"77ce1016","cell_type":"markdown","source":"Trước tiên, chúng ta cần chỉ định một số tham số cho mô hình `XGBoost`.","metadata":{}},{"id":"75baaad8","cell_type":"code","source":"params = {\n    'tree_method': 'hist', \n    'device': 'cuda',  \n    'n_estimators': 500,\n    'max_depth': 8, \n    'learning_rate': 0.05,\n    'objective': 'binary:logistic',\n    'eval_metric': 'logloss'\n}\n\nmodel = XGBClassifier(**params)\nmodel.fit(X_train, y_train)\n\ncalibrated_model = CalibratedClassifierCV(estimator=model, cv='prefit')\ncalibrated_model.fit(X_train, y_train)","metadata":{"execution":{"iopub.status.busy":"2025-05-18T01:18:41.583201Z","iopub.execute_input":"2025-05-18T01:18:41.583488Z","iopub.status.idle":"2025-05-18T01:22:22.757023Z","shell.execute_reply.started":"2025-05-18T01:18:41.583469Z","shell.execute_reply":"2025-05-18T01:22:22.756228Z"},"trusted":true},"outputs":[{"name":"stderr","text":"/usr/local/lib/python3.11/dist-packages/xgboost/core.py:160: UserWarning: [01:20:49] WARNING: /workspace/src/common/error_msg.cc:58: Falling back to prediction using DMatrix due to mismatched devices. This might lead to higher memory usage and slower performance. XGBoost is running on: cuda:0, while the input data is on: cpu.\nPotential solutions:\n- Use a data structure that matches the device ordinal in the booster.\n- Set the device for booster before call to inplace_predict.\n\nThis warning will only be shown once.\n\n  warnings.warn(smsg, UserWarning)\n","output_type":"stream"},{"execution_count":16,"output_type":"execute_result","data":{"text/plain":"CalibratedClassifierCV(cv='prefit',\n                       estimator=XGBClassifier(base_score=None, booster=None,\n                          